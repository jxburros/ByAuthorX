[Desktop Entry]
Type=Application
Name=ByAuthorX
Comment=A word processor for writers, from a first letter to a finished book
Exec=/opt/byauthorx/ByAuthorX %f
Icon=byauthorx
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/x-byauthorx;text/markdown;text/plain;
StartupWMClass=ByAuthorX
