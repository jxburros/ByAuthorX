{
  "schema_version": 1,
  "kind": "byax-settings-collection",
  "collections": {
    "compile": {
      "novel": {
        "label": "Novel",
        "description": "Trade paperback fiction: 5.5 x 8.5 in, mirrored margins, chapter openers with a drop cap and a small-caps lead-in, scene breaks, running heads (author on the left, title on the right) and folios. EPUB with the same structure.",
        "version": 1,
        "target": "pdf",
        "front_matter": [
          {"kind": "half_title", "start": "odd"},
          {"kind": "title_page", "start": "odd"},
          {"kind": "copyright", "start": "next"},
          {"kind": "dedication", "start": "odd"},
          {"kind": "epigraph", "start": "odd"},
          {"kind": "toc", "start": "odd"}
        ],
        "back_matter": [
          {"kind": "acknowledgments", "start": "odd"},
          {"kind": "about_author", "start": "odd"},
          {"kind": "also_by", "start": "odd"}
        ],
        "items": {
          "part": {"start": "odd", "number_style": "words", "label": "Part {number}", "title": "auto", "sink": 144},
          "chapter": {
            "start": "next",
            "number_style": "words",
            "label": "Chapter {number}",
            "title": "auto",
            "drop_cap": true,
            "small_caps_words": 4,
            "sink": 108,
            "numbering": "continuous"
          },
          "scene": {"heading": "separator", "separator": "* * *", "small_caps_words": 0},
          "front": {"start": "odd", "heading": "keep"},
          "back": {"start": "odd", "heading": "keep"}
        },
        "design": {
          "trim": "5.5x8.5",
          "margins": {"top": 54, "bottom": 54, "inside": 54, "outside": 45},
          "gutter": 9,
          "mirror": true,
          "running_heads": {"verso": "{author}", "recto": "{title}", "small_caps": true, "font": "DejaVu Serif", "size": 8},
          "folios": "outside_head",
          "opener_folio": "bottom_center",
          "widows": 2,
          "orphans": 2,
          "bleed": 0,
          "crop_marks": false,
          "image_dpi": 300,
          "restart_numbering": true,
          "docx": {"trim": "letter", "margins": 72}
        },
        "styles": {
          "body": {"font_family": "DejaVu Serif", "font_size": 10.5, "line_spacing": 1.3, "alignment": "justify", "first_line_indent": 15, "space_after": 0, "space_before": 0},
          "compile_chapter_title": {"font_family": "DejaVu Serif", "font_size": 16, "bold": false, "alignment": "center", "space_before": 6, "space_after": 30, "first_line_indent": 0},
          "compile_part_title": {"font_family": "DejaVu Serif", "font_size": 20, "bold": false, "alignment": "center", "space_before": 12, "space_after": 12, "first_line_indent": 0},
          "compile_subheading": {"font_family": "DejaVu Serif", "font_size": 11, "bold": true, "alignment": "left", "space_before": 12, "space_after": 6, "first_line_indent": 0},
          "compile_chapter_label": {"font_size": 10, "small_caps": true, "letter_spacing": 1, "space_after": 8},
          "compile_part_label": {"font_size": 12, "small_caps": true, "letter_spacing": 1.5},
          "compile_drop_cap": {"kind": "character", "font_size": 30, "line_spacing": 1},
          "compile_lead_in": {"kind": "character", "small_caps": true}
        },
        "epub": {
          "embed_fonts": false,
          "css": "p { margin: 0; text-indent: 1.4em }\nh1, h2, h3, h4, h5, h6 { text-indent: 0; text-align: center; font-weight: normal; margin: 2.5em 0 1.5em }\np.s-compile-first, p.s-compile-scene-break, p.s-compile-chapter-label, p.s-compile-part-label, p.s-compile-title, p.s-compile-subtitle, p.s-compile-author, p.s-compile-publisher, p.s-compile-half-title, p.s-compile-copyright, p.s-compile-dedication, p.s-compile-epigraph, p.s-compile-matter-text, p.s-compile-end-mark { text-indent: 0 }\np.s-compile-scene-break { text-align: center; margin: 1em 0 }\np.s-compile-chapter-label, p.s-compile-part-label { text-align: center; font-variant: small-caps; letter-spacing: 0.08em; margin-top: 3em }\n.s-compile-drop-cap { float: left; font-size: 3.2em; line-height: 0.85; margin: 0.06em 0.08em 0 0 }\n.s-compile-lead-in { font-variant: small-caps; letter-spacing: 0.03em }\np.s-compile-title, p.s-compile-half-title { text-align: center; margin-top: 30% }\np.s-compile-copyright { font-size: 0.8em; margin-bottom: 0.4em }\np.s-compile-dedication, p.s-compile-epigraph { text-align: center; font-style: italic; margin-top: 30% }\n"
        }
      }
    }
  },
  "requires": {"provider_aliases": [], "styles": [], "sources": []}
}
