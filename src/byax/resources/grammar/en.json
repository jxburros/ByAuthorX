{
 "language": "en",
 "version": 1,
 "note": "Data-driven grammar rules for the built-in tier. Precision first: each pattern is limited to contexts where the flagged form is wrong. Add a language by installing a pack with a grammar file in this format.",
 "groups": {
  "confusion": "Commonly confused words, flagged only in contexts where one reading is clearly wrong",
  "agreement": "Simple subject-verb agreement patterns",
  "verb_form": "Verb forms: participles after \"have\", \"I seen\", double negatives",
  "pronoun_case": "Pronoun case after prepositions and in compound subjects",
  "quantity": "Fewer/less, number/amount, many/much with clear countable or uncountable nouns",
  "punctuation": "Comma splices, conjunctive adverbs and the pronoun \"I\"",
  "idiom": "Misheard or misspelled fixed phrases",
  "usage": "Run-together words and missing apostrophes"
 },
 "rules": [
  {
   "id": "modal_of",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:could|should|would|must|might)\\s+(of)\\b(?!\\s+course)",
   "message": "After a modal verb use \"have\", not \"of\" (\"should have\").",
   "title": "\"should of\" for \"should have\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "have"
   ]
  },
  {
   "id": "its_for_its_contraction",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(its)\\s+(?:a|an|the|not|been|going|getting|being|how|what|where|who|why|when|always|never|also|okay|ok|fine|about)\\b(?![-’'])",
   "message": "\"its\" is the possessive; here \"it's\" (it is / it has) is meant.",
   "title": "\"its\" for \"it's\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "it's"
   ]
  },
  {
   "id": "contraction_for_its",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(it['’]s)\\s+(?:own|owners?|tail|wings|paws|beak|roots|purpose|shape)\\b(?![-’'])",
   "message": "\"it's\" means \"it is\"; the possessive is \"its\".",
   "title": "\"it's\" for \"its\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "its"
   ]
  },
  {
   "id": "your_for_youre",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(your)\\s+(?:(?:a|an|the|not|too|so|always|never|really|gonna|going\\s+to|about\\s+to)\\b|welcome(?=\\s+to\\b|\\s*[.,!;?]|\\s*$))(?![-’'])",
   "message": "\"your\" is the possessive; here \"you're\" (you are) is meant.",
   "title": "\"your\" for \"you're\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "you're"
   ]
  },
  {
   "id": "youre_for_your",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(you['’]re)\\s+(?:own|name|eyes|hair|opinion|birthday|email\\s+address)\\b(?![-’'])",
   "message": "\"you're\" means \"you are\"; the possessive is \"your\".",
   "title": "\"you're\" for \"your\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "your"
   ]
  },
  {
   "id": "their_for_there",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(their)\\s+(?:is|are|was|were|isn['’]t|aren['’]t|wasn['’]t|weren['’]t|has\\s+been|have\\s+been)\\b",
   "message": "\"their\" is the possessive; here \"there\" is meant.",
   "title": "\"their\" for \"there\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "there"
   ]
  },
  {
   "id": "there_for_their",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(there)\\s+own\\b",
   "message": "\"there\" is a place or a dummy subject; the possessive is \"their\".",
   "title": "\"there\" for \"their\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "their"
   ]
  },
  {
   "id": "theyre_for_their",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(they['’]re)\\s+own\\b",
   "message": "\"they're\" means \"they are\"; the possessive is \"their\".",
   "title": "\"they're\" for \"their\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "their"
   ]
  },
  {
   "id": "then_for_than",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:more|less|better|worse|rather|greater|smaller|larger|bigger|taller|older|younger|faster|slower|other)\\s+(then)\\s+(?:me|you|him|her|us|them|a|an|the|my|your|his|our|their|ever|any|anyone|anything|that)\\b",
   "message": "Comparisons use \"than\", not \"then\".",
   "title": "\"then\" for \"than\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "than"
   ]
  },
  {
   "id": "than_for_then",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:and|but|so|until)\\s+(than)\\s+(?:I|he|she|they|we|you|the|it|there)\\b",
   "message": "\"than\" compares; for sequence use \"then\".",
   "title": "\"than\" for \"then\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "then"
   ]
  },
  {
   "id": "to_for_too_verb",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:want|wants|wanted|need|needs|needed|going|have|has|had|try|tried|trying|like|likes|liked|able|ready|how|time|chance|decided|hoping|hope|plan|planned|started|began|forgot|remember|supposed)\\s+(too)\\s+(?:be|have|do|go|make|get|see|take|come|use|find|help|run|give|tell|know|say|think|work|play|read|write|eat|stay|leave|start|stop|try|keep|let|look|feel|buy|bring|call|meet|show|ask|speak|talk|move|win|learn|understand|visit|sleep|wait)\\b",
   "message": "Before a verb the infinitive marker is \"to\", not \"too\".",
   "title": "\"too\" for \"to\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "to"
   ]
  },
  {
   "id": "too_for_to",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:is|was|are|were|am|way|far)\\s+(to)\\s+(?:much|late|early|soon|big|small|expensive|difficult|loud)\\b(?!-)",
   "message": "Before an adjective or \"much\" meaning \"excessively\", use \"too\".",
   "title": "\"to\" for \"too\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "too"
   ]
  },
  {
   "id": "loose_for_lose",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:to|will|would|might|may|could|can|don['’]t|didn['’]t|won['’]t|not|never|and|or|I|you|we|they|he|she)\\s+(loose)\\s+(?:my|your|his|her|our|their|weight|track|sight|control|hope|faith|interest|money|sleep|focus|touch|patience)\\b",
   "message": "\"loose\" means not tight; the verb is \"lose\".",
   "title": "\"loose\" for \"lose\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "lose"
   ]
  },
  {
   "id": "lose_for_loose",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:a|the|too|so|very)\\s+(lose)\\s+(?:fit|fitting|end|ends|tooth|screw|thread|cannon|clothing|clothes|change|connection|cable|wire|sleeve)\\b",
   "message": "The adjective meaning \"not tight\" is \"loose\".",
   "title": "\"lose\" for \"loose\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "loose"
   ]
  },
  {
   "id": "whos_for_whose",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(who['’]s)\\s+(?:own|name|car|book|idea|turn|fault)\\b(?!-)",
   "message": "\"who's\" means \"who is\"; the possessive is \"whose\".",
   "title": "\"who's\" for \"whose\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "whose"
   ]
  },
  {
   "id": "whose_for_whos",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(whose)\\s+(?:going|coming|been|a|an|not|ready|there|here|responsible|allowed|supposed)\\b",
   "message": "\"whose\" is the possessive; here \"who's\" (who is / who has) is meant.",
   "title": "\"whose\" for \"who's\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "who's"
   ]
  },
  {
   "id": "affect_for_effect",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:a|an|the|no|any|this|that|significant|big|negative|positive|major|profound|little|great|real|huge)\\s+(affect)\\s+(?:on|of|upon)\\b",
   "message": "The noun is \"effect\"; \"affect\" is the verb.",
   "title": "\"affect\" for \"effect\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "effect"
   ]
  },
  {
   "id": "effect_for_affect",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:will|would|could|can|may|might|not|didn['’]t|doesn['’]t|don['’]t|won['’]t|to)\\s+(effect)\\s+(?:my|your|his|her|our|their|us|me|you|them|how|whether)\\b",
   "message": "To influence something is \"to affect\" it; \"effect\" as a verb means to bring about.",
   "title": "\"effect\" for \"affect\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "affect"
   ]
  },
  {
   "id": "weather_for_whether",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(weather)\\s+or\\s+not\\b",
   "message": "\"whether or not\": \"weather\" is the climate.",
   "title": "\"weather\" for \"whether\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "whether"
   ]
  },
  {
   "id": "whether_for_weather",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\bthe\\s+(whether)\\s+(?:was|is|has|outside|today|forecast|report|channel|conditions|turned)\\b",
   "message": "\"whether\" introduces alternatives; the climate is \"the weather\".",
   "title": "\"whether\" for \"weather\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "weather"
   ]
  },
  {
   "id": "lead_for_led",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:was|were|been|is|are|be|being)\\s+(?P<w>lead)\\s+by\\b|\\b(?:has|have|had)\\s+(?P<w>lead)\\s+(?:the|to|a|an|us|me|him|her|them)\\b",
   "message": "The past tense and participle of \"lead\" is \"led\".",
   "title": "\"lead\" for \"led\"",
   "flags": "i",
   "highlight": "w",
   "replacements": [
    "led"
   ]
  },
  {
   "id": "were_for_where",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "(?:^|[.!?][\\\"”']?\\s+)(were)\\s+(?:is|are|do|did|does|was|can|will|would|should|could)\\s+(?:the|you|I|he|she|they|we|it|my|your|his|her|our|their)\\b",
   "message": "For a place, the word is \"where\".",
   "title": "\"were\" for \"where\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "where"
   ]
  },
  {
   "id": "advice_for_advise",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:to|will|would|can|could|should|may)\\s+(advice)\\s+(?:you|him|her|them|us|me|against|on)\\b",
   "message": "The verb is \"advise\"; \"advice\" is the noun.",
   "title": "\"advice\" for \"advise\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "advise"
   ]
  },
  {
   "id": "advise_for_advice",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:some|my|your|his|her|good|bad|any)\\s+(advise)\\b(?!\\s+(?:you|him|her|them|us|me|that|against|on))",
   "message": "The noun is \"advice\"; \"advise\" is the verb.",
   "title": "\"advise\" for \"advice\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "advice"
   ]
  },
  {
   "id": "breath_for_breathe",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:to|can|could|couldn['’]t|can['’]t|must|please|just|cannot)\\s+(breath)\\b(?!\\s+(?:of|test|mint|taking|control|work|and))",
   "message": "The verb is \"breathe\"; \"breath\" is the noun.",
   "title": "\"breath\" for \"breathe\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "breathe"
   ]
  },
  {
   "id": "breathe_for_breath",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:a|the|my|your|his|her|deep|last|bad|fresh|short|long)\\s+(breathe)\\b(?!\\s+(?:in|out|deeply|slowly|easy|again|fresh))",
   "message": "The noun is \"breath\"; \"breathe\" is the verb.",
   "title": "\"breathe\" for \"breath\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "breath"
   ]
  },
  {
   "id": "bare_for_bear",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(bare)\\s+with\\s+me\\b",
   "message": "\"Bear with me\": \"bare\" means uncovered.",
   "title": "\"bare with me\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "bear"
   ]
  },
  {
   "id": "of_for_off",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:jump|jumped|fell|fall|climbed|hopped)\\s+(of)\\s+(?:the|my|your|his|her|their|our|it|me|him|them)\\b",
   "message": "Movement away from something is \"off\", not \"of\".",
   "title": "\"of\" for \"off\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "off"
   ]
  },
  {
   "id": "maybe_for_may_be",
   "group": "confusion",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:it|that|this|he|she|they)\\s+(maybe)\\s+(?:a|an|the|true|false|possible|better|too|time)\\b",
   "message": "As a verb phrase, \"may be\" is two words.",
   "title": "\"maybe\" for \"may be\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "may be"
   ]
  },
  {
   "id": "third_person_dont",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:he|she|it)\\s+(don['’]t)\\b",
   "message": "With \"he\", \"she\" or \"it\" the form is \"doesn't\".",
   "title": "\"he don't\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "doesn't"
   ],
   "skip_dialogue": true
  },
  {
   "id": "third_person_have",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "(?:^|[.!?][\\\"”']?\\s+|\\b(?:and|but|then|because|when|while|so|as)\\s+)(?:he|she|it)\\s+(have)\\b",
   "message": "With \"he\", \"she\" or \"it\" the form is \"has\".",
   "title": "\"he have\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "has"
   ],
   "skip_dialogue": true
  },
  {
   "id": "plural_was",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:they|we|you)\\s+(was)\\b",
   "message": "With \"they\", \"we\" and \"you\" the past form is \"were\".",
   "title": "\"they was\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "were"
   ],
   "skip_dialogue": true
  },
  {
   "id": "plural_pronoun_has",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:they|we|you)\\s+(has)\\b",
   "message": "With \"they\", \"we\" and \"you\" the form is \"have\".",
   "title": "\"they has\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "have"
   ],
   "skip_dialogue": true
  },
  {
   "id": "plural_pronoun_is",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:they|we|you)\\s+(is)\\b",
   "message": "With \"they\", \"we\" and \"you\" the form is \"are\".",
   "title": "\"they is\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "are"
   ],
   "skip_dialogue": true
  },
  {
   "id": "first_person_is_are",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "(?<!\\b(?:letter|numeral|pronoun|word|vitamin|chapter|type|class|grade|part|stage|phase|volume|vol|act|scene|section|case|plan|option|item)\\s)\\b(I)\\s+(is|are)\\b",
   "message": "With \"I\" the form is \"am\".",
   "title": "\"I is\"",
   "highlight": 2,
   "replacements": [
    "am"
   ],
   "skip_dialogue": true
  },
  {
   "id": "first_person_has",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "(?<!\\b(?:letter|numeral|pronoun|word|vitamin|chapter|type|class|grade|part|stage|phase|volume|vol|act|scene|section|case|plan|option|item)\\s)\\b(I)\\s+(has)\\b",
   "message": "With \"I\" the form is \"have\".",
   "title": "\"I has\"",
   "highlight": 2,
   "replacements": [
    "have"
   ],
   "skip_dialogue": true
  },
  {
   "id": "third_person_are",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:he|she|it)\\s+(are)\\b",
   "message": "With \"he\", \"she\" or \"it\" the form is \"is\".",
   "title": "\"he are\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "is"
   ],
   "skip_dialogue": true
  },
  {
   "id": "everyone_are",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:everyone|everybody|someone|somebody|anyone|anybody|nobody|everything|nothing)\\s+(are)\\b",
   "message": "This pronoun is singular; the verb is \"is\".",
   "title": "\"everyone are\"",
   "flags": "i",
   "highlight": 1,
   "replacements": [
    "is"
   ],
   "skip_dialogue": true
  },
  {
   "id": "there_is_plural",
   "group": "agreement",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\bthere\\s+(is|was)\\s+(?:many|several|numerous|few|dozens|hundreds)\\b",
   "message": "A plural subject follows; use \"are\" or \"were\".",
   "title": "\"there is many\"",
   "flags": "i",
   "highlight": 1,
   "replacement_map": {
    "is": "are",
    "was": "were"
   }
  },
  {
   "id": "participle_after_have",
   "group": "verb_form",
   "level": "balanced",
   "severity": "advisory",
   "pattern": "\\b(?:[Hh]ave|[Hh]as|[Hh]ad|[Hh]aving|'ve|’ve)\\s+(went|saw|ran|did|came|took|wrote|ate|began|knew|gave|drank|swam|sang|rode|spoke|broke|chose|forgot|stole|threw|flew|grew|drew|wore|tore|fell|hid|shook|woke|sank|rang|bit|drove)\\b",
   "message": "After \"have\", \"has\" or \"had\" use the past participle, not the simple past.",
   "title": "\"has went\"",
   "highlight": 1,
   "replacement_map": {
    "went": "gone",
    "saw": "seen",
    "ran": "run",
    "did": "done",
    "came": "come",
    "took": "taken",
    "wrote": "written",
    "ate": "eaten",
    "began": "begun",
    "knew": "known",
    "gave": "given",
    "drank": "drunk",
    "swam": "swum",
    "sang": "sung",
    "rode": "ridden",
    "spoke": "spoken",
    "broke": "broken",
    "chose": "chosen",
    "forgot": "forgotten",
    "stole": "stolen",
    "threw": "thrown",
    "flew": "flown",
    "grew": "grown",
    "drew": "drawn",
    "wore": "worn",
    "tore": "torn",
    "fell": "fallen",
    "hid": "hidden",
    "shook": "shaken",
    "woke": "woken",
    "sank": "sunk",
    "rang": "rung",
    "bit": "bitten",
    "drove": "driven"
   }
  },
  {
   "id": "simple_past_for_participle",
   "group": "verb_form",
   "level": "balanced",
